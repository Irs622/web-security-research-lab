# Salin ke deploy/prod/.env lalu sesuaikan. JANGAN commit file .env.
DOMAIN=example.com
ACME_EMAIL=admin@example.com
# URL aplikasi asli yang dilindungi (dari sudut pandang container WAF)
BACKEND_URL=http://host.docker.internal:8000
# DetectionOnly selama masa tuning (1-2 minggu), lalu ubah ke On
MODSEC_RULE_ENGINE=DetectionOnly
PARANOIA=1
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4
# Batas body request (byte) - sesuaikan dengan ukuran upload aplikasi
MODSEC_REQ_BODY_LIMIT=13107200
